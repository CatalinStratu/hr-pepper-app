<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="32dp"
    tools:context=".activities.CompleteActivity">

    <!-- Completion Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp">

            <!-- Check Icon -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="Complete"
                app:tint="#4CAF50"
                android:layout_marginBottom="24dp" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interview Complete!"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <!-- Candidate Name -->
            <TextView
                android:id="@+id/tvCompletionMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thank you, John!"
                android:textSize="18sp"
                android:textColor="#666666"
                android:layout_marginBottom="32dp" />

            <!-- Score Display -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Score"
                android:textSize="16sp"
                android:textColor="#999999"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvScoreDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginBottom="16dp" />

            <!-- Stats -->
            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Questions Answered: 5 / 5"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginBottom="32dp" />

            <!-- Info Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our HR team will review your responses and contact you soon."
                android:textSize="14sp"
                android:textColor="#999999"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <!-- New Interview Button -->
            <Button
                android:id="@+id/btnNewInterview"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start New Interview"
                android:textSize="16sp"
                android:backgroundTint="#1976D2" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
